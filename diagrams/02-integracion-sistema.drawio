        <!-- Box 3 -->
        <mxCell id="d2_j3" value="📈 &lt;b&gt;Escalabilidad&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Cada capa escala horizontalmente según demanda (HPA).&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF3E0;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#FFCC80;strokeWidth=2;" vertex="1" parent="1">
