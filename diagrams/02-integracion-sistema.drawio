      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="t2" value="Diagrama 2: Integración del Sistema — Three-Tier Architecture" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=16;fontStyle=1;color=#1F3A5F;" vertex="1" parent="1">
          <mxGeometry x="200" y="10" width="600" height="40" as="geometry" />
        </mxCell>

        <!-- === COLUMNA IZQUIERDA === -->

        <!-- User -->
        <mxCell id="d2_user" value="&lt;b&gt;Usuario&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Navegador Web&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5277C7;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;strokeColor=#3D5A9E;" vertex="1" parent="1">
          <mxGeometry x="200" y="110" width="140" height="55" as="geometry" />
        </mxCell>

        <!-- Arrow User -> Frontend -->
        <mxCell id="d2_a1" value="HTTP :80" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2_user" target="d2_frontend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Frontend (Nginx) -->
        <mxCell id="d2_frontend" value="&lt;b&gt;Frontend (Nginx)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Puerto 80 · Reverse proxy&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1B813E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;strokeColor=#146B2E;" vertex="1" parent="1">
          <mxGeometry x="180" y="210" width="180" height="65" as="geometry" />
        </mxCell>

        <!-- default.conf box -->
        <mxCell id="d2_nginx_conf" value="&lt;font style='font-size:8px'&gt;&lt;b&gt;default.conf&lt;/b&gt;&lt;br&gt;location /api/ {&lt;br&gt;  proxy_pass &lt;br&gt;  http://localhost:3001;&lt;br&gt;}&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#CCCCCC;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="210" width="120" height="65" as="geometry" />
        </mxCell>

        <!-- Arrow Frontend -> Backend -->
        <mxCell id="d2_a2" value="&lt;i&gt;proxy_pass /api/ :3001&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2_frontend" target="d2_backend">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Backend (Node.js) -->
        <mxCell id="d2_backend" value="&lt;b&gt;Backend (Node.js+Express)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Puerto 3001 · API RESTful&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#232F3E;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;strokeColor=#1A2533;" vertex="1" parent="1">
          <mxGeometry x="170" y="320" width="200" height="65" as="geometry" />
        </mxCell>

        <!-- Endpoints API box -->
        <mxCell id="d2_endpoints" value="&lt;font style='font-size:8px'&gt;&lt;b&gt;Endpoints API&lt;/b&gt;&lt;br&gt;GET /api/productos&lt;br&gt;GET /api/productos/:id&lt;br&gt;POST /api/productos&lt;br&gt;PUT /api/productos/:id&lt;br&gt;DELETE /api/productos/:id&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#CCCCCC;rounded=1;" vertex="1" parent="1">
          <mxGeometry x="390" y="320" width="120" height="65" as="geometry" />
        </mxCell>

        <!-- Arrow Backend -> MySQL -->
        <mxCell id="d2_a3" value="&lt;i&gt;mysql2 query :3306&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="d2_backend" target="d2_mysql">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- MySQL (cylinder) -->
        <mxCell id="d2_mysql" value="&lt;b&gt;MySQL 8&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Persistencia&lt;br&gt;Puerto 3306&lt;/font&gt;" style="shape=cylinder;whiteSpace=wrap;html=1;fillColor=#F5A623;fontColor=#FFFFFF;align=center;verticalAlign=middle;shadow=1;strokeColor=#D4891A;boundedLbl=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="430" width="80" height="65" as="geometry" />
        </mxCell>

        <!-- Schema table box -->
        <mxCell id="d2_schema" value="&lt;font style='font-size:8px'&gt;&lt;b&gt;tabla productos&lt;/b&gt;&lt;br&gt;id INT PK AUTO_INCREMENT&lt;br&gt;nombre VARCHAR(100)&lt;br&gt;descripcion TEXT&lt;br&gt;precio DECIMAL(10,2)&lt;br&gt;imagen VARCHAR(255)&lt;br&gt;created_at TIMESTAMP&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5F5F5;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#CCCCCC;rounded=1;" vertex="1" parent="1">
