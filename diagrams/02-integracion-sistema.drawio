        <mxCell id="d2_j2" value="📦 &lt;b&gt;Separación de Responsabilidades&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Cada capa independiente. Single Responsibility.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#90CAF9;strokeWidth=2;" vertex="1" parent="1">
