        <!-- Three-Tier box -->
        <mxCell id="d2_tier" value="&lt;b&gt;Arquitectura en 3 Capas (Three-Tier)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;Presentación → Lógica → Persistencia&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#FFAB91;strokeWidth=2;" vertex="1" parent="1">
