        <!-- === COLUMNA DERECHA (Justificaciones) === -->

        <!-- Box 1 -->
        <mxCell id="d2_j1" value="🔒 &lt;b&gt;Seguridad&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:9px'&gt;El frontend oculta la topología interna. Solo puerto 80 expuesto.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;fontColor=#333333;align=center;verticalAlign=middle;shadow=0;strokeColor=#A5D6A7;strokeWidth=2;" vertex="1" parent="1">
